<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
             x:Class="TabViewHeaderCloseButton.MainPage">


    <tabView:SfTabView ItemsSource="{Binding Tabs}" EnableRippleAnimation="False" IndicatorBackground="LightPink" IndicatorPlacement="Fill">
        <tabView:SfTabView.HeaderItemTemplate>
            <DataTemplate>
                <Grid Padding="8,4" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label WidthRequest="110" Text="{Binding Title}" VerticalTextAlignment="Center"/>

                    <Border ZIndex="1"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="14,-6,0,0"
                            BackgroundColor="LightBlue"
                            WidthRequest="18"
                            HeightRequest="18"
                            Padding="0">
                        <Button Text="✕"
                              FontSize="12"
                              BackgroundColor="Red"
                              TextColor="Black"
                              WidthRequest="18"
                              HeightRequest="18"
                              Clicked="OnCloseClicked"
                              CommandParameter="{Binding .}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </tabView:SfTabView.HeaderItemTemplate>

        <tabView:SfTabView.ContentItemTemplate>
            <DataTemplate>
                <Grid Padding="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="300"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <HorizontalStackLayout Grid.Row="0" Spacing="8">
                        <Label Text="{Binding Title}"
                       FontAttributes="Bold"
                       FontSize="18"
                       VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>

                    <BoxView Grid.Row="1" HeightRequest="1" Color="#E0E0E0"/>

                    <ScrollView Grid.Row="2">
                        <Label Text="{Binding ContentText}"
                       FontSize="14"
                       TextColor="#333333"/>
                    </ScrollView>
                    <HorizontalStackLayout Grid.Row="3" Spacing="10">
                        <Button Text="Refresh"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        CornerRadius="8"
                        Clicked="OnRefreshClicked"/>
                        <Button Text="More"
                        BackgroundColor="#EEEEEE"
                        TextColor="#333333"
                        CornerRadius="8"
                        Clicked="OnMoreClicked"/>
                    </HorizontalStackLayout>
                </Grid>
            </DataTemplate>
        </tabView:SfTabView.ContentItemTemplate>

    </tabView:SfTabView>

</ContentPage>
